# ============================================================
# B Tracker — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# DO NOT put real credentials here — this file IS committed to GitHub.
#
# How to get these values:
# 1. Firebase API Key & Project ID → https://console.firebase.google.com
#    → Your Project → Project Settings → General → Your apps
# 2. Google OAuth Client ID → https://console.cloud.google.com
#    → APIs & Services → Credentials → OAuth 2.0 Client IDs

EXPO_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY_HERE
EXPO_PUBLIC_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID_HERE
EXPO_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID_HERE
